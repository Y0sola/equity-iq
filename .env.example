# EquityIQ configuration. Copy to .env and replace every placeholder.
# Never commit .env: it is git-ignored.

# PostgreSQL connection
EQUITYIQ_DB_HOST=localhost
EQUITYIQ_DB_PORT=5432
EQUITYIQ_DB_NAME=equityiq
EQUITYIQ_TEST_DB_NAME=equityiq_test

# Owner role: used only by the ingestion/validation pipeline (creates and writes data)
EQUITYIQ_DB_USER=equityiq_owner
EQUITYIQ_DB_PASSWORD=change_me

# Read-only role: used by the API (SELECT-only grants, read-only sessions, 5 s timeout)
EQUITYIQ_READER_USER=equityiq_reader
EQUITYIQ_READER_PASSWORD=change_me_too

# Superuser used only by scripts/db_init.sh to create the roles and databases.
# Homebrew PostgreSQL: your macOS username. Docker Compose: postgres.
PG_ADMIN_USER=postgres

# Optional
# EQUITYIQ_API_DATABASE=main                 # "test" points the API at the test database (API tests only)
# EQUITYIQ_CORS_ORIGINS=http://localhost:5173
# EQUITYIQ_API_PORT=8000                     # port the Vite dev server proxies /api to
